package cz.smartarch.aidev.semiformal.compaid.espidf


annotation "cz.smartarch.aidev.semiformal" as SemiFormal

abstract class Entity {
	String identification
}

enum Type {
	INT
	STRING
	BOOLEAN
	CUSTOM
}

enum ConnectorStyle {
	EVENT_PUBSUB
	CALL
}

enum ConnectorRole {
	PUBLISHER
	SUBSCRIBER
	CALLER
	CALLEE
}

enum Severity {
	DEBUG
	INFO
	WARN
	ERROR
}

enum TriggerKind {
	EVENT_ABSENCE
	EVENT_RATE
}

enum CallScope {
	LOCAL
	EXTERNAL
}

class Component extends Entity {
	@SemiFormal(
		context = "A component is the authoritative specification of one ESP-IDF software component. Its description explains the component's responsibility within the application and frames the meaning of its configurations, callbacks, tasks, connectors, events, metrics, alerts, and tests.",
		authoring = "Write one short paragraph in present tense. State the component's main responsibility, the subsystem or hardware/service it controls, and the externally visible behavior it provides. Do not restate only the component identifier. Mention important lifecycle or concurrency assumptions when they affect how other components use it.",
		review = "(i) the prose describes a single coherent component responsibility; (ii) the prose is consistent with the declared dependencies, connectors, events, and tasks; (iii) it does not introduce undeclared external interactions. The description is complete once these hold.",
		generateCode = "Use the description to choose cohesive source-file organization, comments, and lifecycle wiring for the component. Preserve the stated responsibility boundary and do not generate behavior that belongs to another component."
	)
	String description

	refers ESPIDFDependency[] dependencies

	contains Configuration[] configurations
	contains Initialization initialization
	contains Callback[] callbacks
	contains Task[] tasks
	contains InternalState internalState
	contains Connector[] connectors
	contains Event[] events
	contains Metric[] metrics
	contains Alert[] alerts
	contains ComponentTestPlan[] componentTestPlans
	contains ApplicationTestPlan[] applicationTestPlans
}

class Configuration extends Entity {
	@SemiFormal(
		context = "A configuration entry describes a value that parameterizes the enclosing component and may affect generated initialization, runtime behavior, or deployment-specific settings.",
		authoring = "Write one concise sentence or paragraph in present tense. Explain what the value controls, its unit or format when relevant, valid range or special values, and whether changing it requires rebuild, restart, or reinitialization.",
		review = "(i) the prose agrees with `valueType`, `customType`, `defaultValue`, `range`, and `environmentSpecific`; (ii) any unit, bound, or special value mentioned in prose is reflected structurally when possible; (iii) the effect of the configuration is clear to a user and generator. The description is complete once these hold.",
		generateCode = "Use the description to name generated constants or accessors, add useful comments, and apply validation or conversion implied by the declared type, range, default value, and environment-specific flag."
	)
	String description

	Type valueType = "CUSTOM"
	String customType
	String defaultValue
	String range
	boolean environmentSpecific
}

class ESPIDFDependency extends Entity {
}

class Initialization {
	contains InitializationPrerequisite[] prerequisites
	contains InitializationStage[] stages
}

class InitializationPrerequisite extends Entity {
	@SemiFormal(
		context = "An initialization prerequisite records a resource, subsystem, or call that must be available before the enclosing component can be initialized safely.",
		authoring = "Write one short sentence in present tense. State what must already exist or have been initialized, why it is needed, and which `resource` or `initCall` provides it.",
		review = "(i) the prose matches `resource` and `initCall`; (ii) the prerequisite is genuinely required before initialization; (iii) the consequence of the missing prerequisite is understandable. The description is complete once these hold.",
		generateCode = "Use the description to order initialization, emit checks or comments for required resources, and avoid generating initialization code before the prerequisite is satisfied."
	)
	String description

	String resource
	String initCall
}

class InitializationStage extends Entity {
	@SemiFormal(
		context = "An initialization stage describes one ordered step in the component lifecycle and the assumptions that hold before and after that step.",
		authoring = "Write one short paragraph in present tense. State what the stage does, which dependencies from `dependsOn` it relies on, and what state or service becomes available after the stage completes.",
		review = "(i) the prose agrees with the listed `dependsOn` entries; (ii) it does not rely on undeclared components or stages; (iii) the postcondition of the stage is clear. The description is complete once these hold.",
		generateCode = "Use the description to place initialization calls into the correct ESP-IDF lifecycle order and to preserve dependency ordering between generated component initialization stages."
	)
	String description

	contains StageDependency[] dependsOn
}

class StageDependency extends Entity {
	@SemiFormal(
		context = "A stage dependency explains why an initialization stage of the enclosing component depends on another component or stage.",
		authoring = "Write one concise sentence in present tense. Name the required component or stage and explain the specific service, state, or resource that must be available.",
		review = "(i) the prose matches `component` and `stage`; (ii) `reason` and the prose state the same dependency rationale; (iii) the dependency is necessary rather than incidental. The description is complete once these hold.",
		generateCode = "Use the description to justify generated initialization ordering and to add comments where dependency ordering is not obvious from the structure alone."
	)
	String description

	refers Component component
	String stage

	@SemiFormal(
		context = "A reason states the rationale for the enclosing stage dependency: why the enclosing component's stage requires the named `component`'s `stage` to have completed first. It is the short, structural counterpart of `description`.",
		authoring = "Write one concise sentence in present tense. State the specific service, state, or resource that the named `component`'s `stage` makes available and that the enclosing stage relies on. Avoid generic phrases such as 'X must be initialized first' that do not name what is provided.",
		review = "(i) the rationale names a specific service, state, or resource; (ii) the named provider is the depended-on `component` and `stage`; (iii) the reason is consistent with `description` when both are present; (iv) the dependency is necessary rather than incidental. The reason is complete once these hold.",
		generateCode = "Use the reason to add a brief comment at the corresponding `<component>_init(stage)` call site in `main`, explaining why the topological ordering places this stage after the depended-on stage."
	)
	String reason
}

class Callback extends Entity {
	@SemiFormal(
		context = "A callback describes a function supplied by or invoked within the component in response to an ESP-IDF, driver, or application event.",
		authoring = "Write one short paragraph in present tense. State when the callback is invoked, the execution context or task it runs in, what inputs it observes, what side effects it may perform, and whether it may block.",
		review = "(i) the invocation condition is clear; (ii) execution context, blocking behavior, and side effects are stated when relevant; (iii) the prose is consistent with related connectors, events, tasks, and state variables. The description is complete once these hold.",
		generateCode = "Use the description to generate the callback signature, registration, body outline, synchronization, and comments respecting the stated execution context and blocking constraints."
	)
	String description
}

class Task extends Entity {
	@SemiFormal(
		context = "A task describes a FreeRTOS or ESP-IDF execution activity owned by the component.",
		authoring = "Write one short paragraph in present tense. State the task's purpose, when it starts and stops, its triggering or loop behavior, important timing constraints, and which state, connectors, events, or metrics it uses.",
		review = "(i) lifecycle, trigger, and termination behavior are clear; (ii) the prose is consistent with declared state, connectors, events, and metrics; (iii) concurrency assumptions and blocking behavior are stated when relevant. The description is complete once these hold.",
		generateCode = "Use the description to create the task function, scheduling and loop structure, synchronization, and cleanup code while preserving the stated timing and lifecycle behavior."
	)
	String description
}

class InternalState {
	contains StateVariable[] variables
}

class StateVariable extends Entity {
	@SemiFormal(
		context = "A state variable describes internal mutable or cached state owned by the enclosing component.",
		authoring = "Write one concise sentence or paragraph in present tense. State what the variable represents, its ownership and lifetime, how it is initialized, and which callbacks, tasks, or connectors read or update it.",
		review = "(i) the prose agrees with `dataType` and `initialValue`; (ii) ownership, lifetime, and update responsibilities are clear; (iii) concurrency or synchronization requirements are stated when relevant. The description is complete once these hold.",
		generateCode = "Use the description to declare the variable, initialize it, protect concurrent access, and release resources according to the stated ownership and lifetime."
	)
	String description

	String dataType
	String initialValue
}

abstract class Connector extends Entity {
	ConnectorStyle connectorStyle
	ConnectorRole role
}

class EventPubSubConnector extends Connector {
	@SemiFormal(
		context = "An event-pub/sub connector describes publication to or subscription from an event bus between the enclosing component and other components or ESP-IDF services.",
		authoring = "Write one short paragraph in present tense. State whether the connector publishes or subscribes, name the event base and event id, describe the payload fields, and explain when the handler is invoked or when the event is emitted.",
		review = "(i) the prose agrees with `role`, `connectorKind`, `bus`, `event`, `handler`, and `payload`; (ii) every payload field used in prose is declared; (iii) publication or subscription direction is unambiguous. The description is complete once these hold.",
		generateCode = "Use the description to generate event registration or posting code, handler dispatch, payload construction or decoding, and comments that preserve the stated direction and event semantics."
	)
	String description

	String bus
	contains EventSelector event
	String handler
	contains Field[] payload
}

class EventSelector {
	String base
	String eventId
}

class CallConnector extends Connector {
	@SemiFormal(
		context = "A call-based connector describes an invocation made from the enclosing component to a target function on another component.",
		authoring = "Write one short paragraph in present tense. Name the target function, state what is passed and returned. If any pointer is exchanged, state the ownership rule explicitly (e.g., 'the callee retains the reference until deinit').",
		review = "(i) the target named in prose matches `call.function`; (ii) `role` and `connectorKind` agree with the prose; (iii) whenever a pointer is exchanged, an ownership rule is stated. The description is complete once these hold.",
		generateCode = "Emit the call to `call.function` in the appropriate ESP-IDF lifecycle stage. Honour the stated ownership rule: when the callee retains a reference, keep the pointed-to object alive until deinit."
	)
	String description

	contains Call call
}

class Call {
	CallScope scope = "LOCAL"
	String function
	contains Message request
	contains Message response
}

class Message {
	contains Field[] fields
}

class Field extends Entity {
	String dataType

	@SemiFormal(
		context = "A field documentation explains the meaning, unit, source, and constraints of one structured payload or message field used by an event, queue message, or call connector. The documentation, not the data type alone, fixes how the value is to be interpreted.",
		authoring = "Write one short sentence in present tense. State what the value represents, its unit, byte order or encoding when relevant, and the source or computation that produces it (e.g., 'from esp_timer_get_time()'). Do not restate the field id.",
		review = "(i) the documentation is consistent with `dataType`; (ii) unit, encoding, byte order, or special values (e.g., zero meaning 'never set') are stated when the data type alone does not fix them; (iii) the source or producing operation is identifiable; (iv) the documentation does not duplicate the field id. The documentation is complete once these hold.",
		generateCode = "Use the documentation to emit a field-level comment on the generated payload struct member, choose a parser or formatter consistent with the stated encoding (e.g., network byte order conversions for IPv4 addresses), and preserve the stated unit at every read and write site."
	)
	String documentation
}

class Event extends Entity {
	@SemiFormal(
		context = "An event describes an observable condition emitted by the component for other components, tests, monitoring, or alerting.",
		authoring = "Write one short paragraph in present tense. State what condition the event represents, when it is emitted, the meaning of its fields, and how `severity` should be interpreted.",
		review = "(i) the prose agrees with `severity` and declared `fields`; (ii) emission conditions are specific enough for code generation and tests; (iii) consumers can understand the event without reading implementation code. The description is complete once these hold.",
		generateCode = "Use the description to generate event definitions, emission sites, payload population, logging, and test assertions consistent with the stated condition and severity."
	)
	String description

	Severity severity = "INFO"
	contains Field[] fields
}

class Metric extends Entity {
	@SemiFormal(
		context = "A metric describes an observable quantity recorded by the enclosing component for continuous observation, alerting, or aggregation. The documentation fixes what the metric measures and how its value evolves; metric meaning must remain stable across revisions.",
		authoring = "Write one short sentence in present tense. State the measured quantity, the unit when not implied by the quantity, the reset or aggregation semantics (e.g., 'since boot', 'rolling 60 s window'), and the operation or moment that updates it (e.g., 'increments in the tick callback').",
		review = "(i) exactly one quantity is named; (ii) the unit is stated when not implied; (iii) reset or aggregation semantics are explicit; (iv) the update site is identifiable from declared callbacks, tasks, connectors, or events; (v) the metric is genuinely observed continuously rather than a one-off occurrence better expressed as an event. The documentation is complete once these hold.",
		generateCode = "Use the documentation to choose counter or gauge semantics, name the generated metric storage from `identification`, and place the increment or assignment at the precise behavior point named in the prose. Do not invent a hidden metrics transport unless the project adds one explicitly."
	)
	String documentation
}

class Alert extends Entity {
	@SemiFormal(
		context = "An alert describes a noteworthy or abnormal situation derived from events or metrics and intended for monitoring, diagnostics, or operator attention.",
		authoring = "Write one short paragraph in present tense. State what problem or condition the alert signals, how the `trigger` detects it, what `severity` means, and what operator or system reaction is expected.",
		review = "(i) the prose agrees with `severity` and `trigger`; (ii) the triggering event, window, and threshold semantics are clear when present; (iii) the expected reaction is actionable. The description is complete once these hold.",
		generateCode = "Use the description to generate monitoring checks, alert messages, logging, and test expectations that preserve the stated trigger and severity semantics."
	)
	String description

	Severity severity = "WARN"
	contains Trigger trigger
}

class Trigger {
	TriggerKind triggerKind
	refers Event event
	int windowMs
	int threshold
}

class ComponentTestPlan extends Entity {
	@SemiFormal(
		context = "A component test plan describes how the enclosing component should be tested in isolation or with controlled collaborators.",
		authoring = "Write one short paragraph in present tense. State the test scope, fixtures or mocks, main behaviors to verify, and how the listed `tests` and `path` relate to generated or existing tests.",
		review = "(i) the prose is consistent with `path` and the listed test cases; (ii) the plan covers the component's important configurations, callbacks, connectors, events, and state changes; (iii) expected outcomes are clear enough for test generation. The description is complete once these hold.",
		generateCode = "Use the description to generate or organize component tests at `path`, create fixtures and mocks, and derive assertions for the listed test cases and described behaviors."
	)
	String description

	String path
	contains TestCase[] tests
}

class TestCase {
	@SemiFormal(
		context = "A test case states one observable behavior or invariant that the generated component test must verify. Its scope is fixed by the enclosing `ComponentTestPlan`; initialization-failure paths are out of scope because init errors are fatal.",
		authoring = "State exactly one observable behavior in present tense. Phrase it as a predicate that becomes true under stated input or stimulus. Reference only declared events, state variables, configurations, or connector calls. Do not describe implementation steps such as function bodies, library calls, or internal control flow.",
		review = "(i) one and only one observable predicate is stated; (ii) every entity referenced is declared in the surrounding component contract; (iii) the predicate is decidable from artifacts a test harness can observe (events on the bus, return values of call connectors, state exposed through declared connectors); (iv) implementation details are not asserted. The case is complete once these hold.",
		generateCode = "Emit one Unity `TEST_CASE(\"name\", \"[tags]\")` per text entry under the test app at the enclosing plan's `path`. The generated assertion must capture exactly the stated predicate; the case name must trace back unambiguously to the text. Use `WHOLE_ARCHIVE` registration so `TEST_CASE` entries are not dead-stripped."
	)
	String text
}

class ApplicationTestPlan extends Entity {
	@SemiFormal(
		context = "An application test plan entry expresses one application-level acceptance requirement, verified at full-system scope rather than against a single component in isolation. The acceptance surface may be a user-visible outcome or a declared observability surface (event, metric, trace) that the application intentionally exposes.",
		authoring = "Write one short paragraph in present tense. State the user-visible outcome or declared observability surface that must hold, the precondition or trigger that brings it about, and any timing budget or stability window. Do not duplicate component-level connector mechanics unless they are themselves the intended acceptance surface.",
		review = "(i) the outcome is observable at application scope, not only inside one component; (ii) the timing budget or stability window is stated when relevant; (iii) the requirement does not duplicate a `ComponentTestPlan` test; (iv) when `testExecution` is `manual`, `operatorAction` is provided. The doc is complete once these hold.",
		generateCode = "Use the doc to generate a pytest case under `tests/<scope>/`, where `<scope>` is the dominating component or the cooperating feature/domain. Apply `@pytest.mark.manual` when `testExecution` is `manual` so it is excluded from automated runs via `-m \"not manual\"`. Encode the timing budget as bounded polling with explicit timeouts; assert against declared events, metrics, or external observable surfaces, not internal implementation."
	)
	String doc

	String testExecution

	@SemiFormal(
		context = "An operator action describes the human-performed steps required by a manual application test. It is consumed by the human tester and by documentation generation rather than by code generation. It applies only when `testExecution` is `manual` and is ignored otherwise.",
		authoring = "Write a short sequence of imperative steps in present tense. For each step, state the precondition under which it is performed, the exact operator action, the observable outcome the test will wait for, and the timeout for that wait. Do not include steps already performed by the automated test driver, and do not embed implementation details of the system under test.",
		review = "(i) each step has a single, unambiguous operator action; (ii) every wait has an explicit timeout; (iii) the steps are reproducible without further explanation by someone who has not seen the system before; (iv) the enclosing plan entry has `testExecution = manual`. The action is complete once these hold.",
		generateDocumentation = "Use the action to generate the operator runbook section for this acceptance test. Render the steps as a numbered list with explicit timeouts and observable outcomes; cross-reference the corresponding pytest case marked `@pytest.mark.manual`."
	)
	String operatorAction
}


class CONTAINER {
	contains Component[] components
	contains ESPIDFDependency[] dependencies
}
